      m_Calls: []
  m_text: "Legend:\n\nAccuracy:\t\t\t\t\t\tHow often your decisions were correct
    overall.\nAccuracy per Group:\t\t\t\tHow accurate you were for each image category
    \t \t\t\t\t\t\t\tlike animals, humans, architecture, or text.\nAccuracy per Real/Fake:\t\t\t\tHow
    well you identified real images compared to  \t\t\t\t\t\t\t\tfake images.\nSuspicion
    Bias:\t\t\t\t\tHow often you tended to judge images as fake.\nFalse Positive
    Rate:\t\t\t\tHow often you incorrectly judged real images as  \t\t\t\t\t\t\t\tfake.\nFalse
    Negative Rate:\t\t\t\tHow often you incorrectly judged fake images as  \t\t\t\t\t\t\t\treal.\nAverage
    Confidence:\t\t\t\tYour average confidence level across all  \t\t\t\t\t\t\t\t\tdecisions.\nAverage
    Confidence per Correctness:\tHow confident you were when your decisions  \t\t\t\t\t\t\t\t\twere
    correct versus incorrect."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
