--- !u!114 &1290819041
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1290819039}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Notizbuch \u2013 Medienpr\xFCfung\n\nHeute habe ich bei der FIrma angefangen.\nDie
    Firma pr\xFCft Bilder, Texte und Videos darauf, ob sie echt sind oder von KI
    erstellt wurden. Noch ist alles \xFCberschaubar, aber das Ziel ist gro\xDF: Menschen
    sollen wissen, welchen Medien sie vertrauen k\xF6nnen.\n\nJede richtige Entscheidung
    erh\xF6ht den Trust Value der Firma. Und je h\xF6her dieser Wert steigt, desto
    mehr w\xE4chst die Firma. Mehr Vertrauen bedeutet mehr Auftr\xE4ge, neue Mitarbeiter,
    bessere Technik und gr\xF6\xDFere Verantwortung.\n\nDieses Notizbuch soll mir
    helfen, besser darin zu werden, Medien zu beurteilen. Jeden Tag schreibe ich
    auf, was ich dazulerne: Hinweise, Muster und Fehler, auf die ich achten kann.\n\nAm
    Anfang erkenne ich wahrscheinlich nur das Offensichtliche.\nAber wenn ich genauer
    arbeite, w\xE4chst nicht nur mein Wissen, sondern die ganze Firma."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4278190080
  m_fontColor: {r: 0, g: 0, b: 0, a: 1}
  m_enableVertexGradient: 0
  m_colorMode: 3
  m_fontColorGradient:
    topLeft: {r: 1, g: 1, b: 1, a: 1}
    topRight: {r: 1, g: 1, b: 1, a: 1}
    bottomLeft: {r: 1, g: 1, b: 1, a: 1}
    bottomRight: {r: 1, g: 1, b: 1, a: 1}
  m_fontColorGradientPreset: {fileID: 0}
