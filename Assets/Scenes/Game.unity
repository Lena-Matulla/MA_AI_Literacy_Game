  m_EditorClassIdentifier: 
  canvas: {fileID: 376286512}
  BookPanel: {fileID: 678860386}
  background: {fileID: 2746070240498474880, guid: 2bfc192b1ae2f674ab682b50cb9638db, type: 3}
  bookPages:
  - {fileID: -3769811031853554458, guid: 2a4814a5d015d1c4eb489e4f3876fa26, type: 3}
  - {fileID: 2191943901429787008, guid: 9ef7cc6e64cf05e48b071df9ed36ac90, type: 3}
  - {fileID: -3769811031853554458, guid: 2a4814a5d015d1c4eb489e4f3876fa26, type: 3}
  - {fileID: 2191943901429787008, guid: 9ef7cc6e64cf05e48b071df9ed36ac90, type: 3}
  - {fileID: -3769811031853554458, guid: 2a4814a5d015d1c4eb489e4f3876fa26, type: 3}
  - {fileID: 2191943901429787008, guid: 9ef7cc6e64cf05e48b071df9ed36ac90, type: 3}
  - {fileID: -3769811031853554458, guid: 2a4814a5d015d1c4eb489e4f3876fa26, type: 3}
  - {fileID: 2191943901429787008, guid: 9ef7cc6e64cf05e48b071df9ed36ac90, type: 3}
  interactable: 1
  enableShadowEffect: 1
  currentPage: 0
  ClippingPlane: {fileID: 697289776}
